# Quote any value containing # (e.g. KEY="a#b") — unquoted # starts a
# comment and truncates the value.

# Neon Postgres connection string.
DATABASE_URL=

# Secret pepper mixed into every agent API key's secret before hashing
# (sha256(API_KEY_PEPPER + secret)). Never commit a real value; tests use a
# fixed test-only pepper.
API_KEY_PEPPER=

# Signs the mandate_session owner cookie (HMAC-SHA256). Required in production
# (at least 32 characters; e.g. `openssl rand -base64 48`). Dev/test fall back
# to a fixed development value with a warning.
SESSION_SECRET=

# PayPal sandbox REST app credentials.
PAYPAL_BASE_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Per-call HTTP timeout (ms) for the PayPal rail client. Optional; falls
# back to a built-in default when unset.
PAYPAL_TIMEOUT_MS=

# PayPal sandbox accounts used by spikes and Playwright flows (headless
# buyer login + the bank's own merchant/payee account).
PAYPAL_BANK_EMAIL=
PAYPAL_BANK_PASSWORD=
PAYPAL_CLIENT_EMAIL=
PAYPAL_CLIENT_PASSWORD=
PAYPAL_OWNER_EMAIL=
PAYPAL_OWNER_PASSWORD=
PAYPAL_LENDER_EMAIL=
PAYPAL_LENDER_PASSWORD=

# Public base URL of this deployment (used to build docs_url, webhooks, etc).
PUBLIC_BASE_URL=

# OpenAI (Responses API) for underwriting explanations and document review.
OPENAI_API_KEY=
OPENAI_MODEL_UNDERWRITER=
OPENAI_MODEL_CHECK=
# 1 = never call OpenAI; every AI role uses its deterministic template (still logged in ai_runs).
OPENAI_DISABLED=

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>` to
# /api/cron/reconcile and /api/cron/tick. Without it every cron call is 401.
CRON_SECRET=

# Ruling W: the bank's opening capital per world, in integer cents (default
# 10000). Posted once per world as Dr cash_paypal / Cr bank_equity; it covers
# PayPal's fees (the bank's expense). On the real PayPal rail it represents
# sandbox funds already in the bank's PayPal account — keep it at or below
# that account's balance. 0 disables it.
BANK_SEED_CAPITAL_CENTS=10000

# P7: Bryntum 8.x license key (Scheduler + Calendar), applied client-side via bryntum.licenseKey.
# Without it the Timeline / Calendar run as a Bryntum trial.
BRYNTUM_LICENSE_KEY=
