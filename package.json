{
  "name": "agentic-bank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sandbox": "RUN_SANDBOX_E2E=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run tests/integration/core-loop.sandbox.test.ts --testTimeout=600000 --hookTimeout=300000",
    "test:agents": "tsx --env-file=.env.local tests/acceptance/run.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:pg": "vitest run --config vitest.pg.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.11.0",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "drizzle-orm": "^0.45.4",
    "mcp-handler": "^2.3.0",
    "next": "16.4.5",
    "openai": "^7.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^17.11.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fast-check": "^4.10.2",
    "msw": "^3.0.3",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
