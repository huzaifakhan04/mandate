<?xml version="1.0" encoding="utf-8"?>
<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:schemas="https://agentic-bank-mu.vercel.app/schemas" xmlns="http://wadl.dev.java.net/2009/02">
  <doc title="Mandate Bank API" xml:lang="en">Mandate is a sandbox bank for AI agents on PayPal sandbox: buy lender notes, borrow short-term loans, repay. Every tool is also an MCP tool at /api/mcp/mcp; full agent guide at /agents.md. Sandbox only — no real money.</doc>
  <grammars>
    <xs:schema xmlns:tns="https://agentic-bank-mu.vercel.app/schemas" targetNamespace="https://agentic-bank-mu.vercel.app/schemas" xmlns:xs="http://www.w3.org/2001/XMLSchema">
      <xs:element name="Envelope" type="schemas:Envelope" />
      <xs:element name="ApiV1AcceptOfferRequest" type="schemas:ApiV1AcceptOfferRequest" />
      <xs:element name="ApiV1AckNoticesRequest" type="schemas:ApiV1AckNoticesRequest" />
      <xs:element name="ApiV1ApplyForLoanRequest" type="schemas:ApiV1ApplyForLoanRequest" />
      <xs:element name="ApiV1BuyNotesRequest" type="schemas:ApiV1BuyNotesRequest" />
      <xs:element name="ApiV1CancelRedemptionRequest" type="schemas:ApiV1CancelRedemptionRequest" />
      <xs:element name="ApiV1CheckEligibilityRequest" type="schemas:ApiV1CheckEligibilityRequest" />
      <xs:element name="ApiV1ConfirmCheckoutRequest" type="schemas:ApiV1ConfirmCheckoutRequest" />
      <xs:element name="ApiV1DeclineOfferRequest" type="schemas:ApiV1DeclineOfferRequest" />
      <xs:element name="ApiV1GetApplicationRequest" type="schemas:ApiV1GetApplicationRequest" />
      <xs:element name="ApiV1GetLoanRequest" type="schemas:ApiV1GetLoanRequest" />
      <xs:element name="ApiV1RedeemNotesRequest" type="schemas:ApiV1RedeemNotesRequest" />
      <xs:element name="ApiV1RegisterAgentRequest" type="schemas:ApiV1RegisterAgentRequest" />
      <xs:element name="ApiV1RegisterPublicKeyRequest" type="schemas:ApiV1RegisterPublicKeyRequest" />
      <xs:element name="ApiV1RepayLoanRequest" type="schemas:ApiV1RepayLoanRequest" />
      <xs:element name="Collateral" type="schemas:Collateral" />
      <xs:element name="Declarations" type="schemas:Declarations" />
      <xs:element name="Identity" type="schemas:Identity" />
      <xs:element name="Invoice" type="schemas:Invoice" />
      <xs:element name="NextAction" type="schemas:NextAction" />
      <xs:element name="bodyObjectType" type="schemas:bodyObjectType" />
      <xs:element name="get_bank_guide_Request" type="schemas:get_bank_guide_Request" />
      <xs:element name="get_bank_guide200_Response0" type="schemas:get_bank_guide200_Response0" />
      <xs:element name="register_agent_Request" type="schemas:register_agent_Request" />
      <xs:element name="register_agent200_Response0" type="schemas:register_agent200_Response0" />
      <xs:element name="get_status_Request" type="schemas:get_status_Request" />
      <xs:element name="get_status200_Response0" type="schemas:get_status200_Response0" />
      <xs:element name="register_public_key_Request" type="schemas:register_public_key_Request" />
      <xs:element name="register_public_key200_Response0" type="schemas:register_public_key200_Response0" />
      <xs:element name="buy_notes_Request" type="schemas:buy_notes_Request" />
      <xs:element name="buy_notes200_Response0" type="schemas:buy_notes200_Response0" />
      <xs:element name="confirm_checkout_Request" type="schemas:confirm_checkout_Request" />
      <xs:element name="confirm_checkout200_Response0" type="schemas:confirm_checkout200_Response0" />
      <xs:element name="check_eligibility_Request" type="schemas:check_eligibility_Request" />
      <xs:element name="check_eligibility200_Response0" type="schemas:check_eligibility200_Response0" />
      <xs:element name="apply_for_loan_Request" type="schemas:apply_for_loan_Request" />
      <xs:element name="apply_for_loan200_Response0" type="schemas:apply_for_loan200_Response0" />
      <xs:element name="accept_offer_Request" type="schemas:accept_offer_Request" />
      <xs:element name="accept_offer200_Response0" type="schemas:accept_offer200_Response0" />
      <xs:element name="decline_offer_Request" type="schemas:decline_offer_Request" />
      <xs:element name="decline_offer200_Response0" type="schemas:decline_offer200_Response0" />
      <xs:element name="get_application_Request" type="schemas:get_application_Request" />
      <xs:element name="get_application200_Response0" type="schemas:get_application200_Response0" />
      <xs:element name="get_loan_Request" type="schemas:get_loan_Request" />
      <xs:element name="get_loan200_Response0" type="schemas:get_loan200_Response0" />
      <xs:element name="repay_loan_Request" type="schemas:repay_loan_Request" />
      <xs:element name="repay_loan200_Response0" type="schemas:repay_loan200_Response0" />
      <xs:element name="ack_notices_Request" type="schemas:ack_notices_Request" />
      <xs:element name="ack_notices200_Response0" type="schemas:ack_notices200_Response0" />
      <xs:element name="redeem_notes_Request" type="schemas:redeem_notes_Request" />
      <xs:element name="redeem_notes200_Response0" type="schemas:redeem_notes200_Response0" />
      <xs:element name="cancel_redemption_Request" type="schemas:cancel_redemption_Request" />
      <xs:element name="cancel_redemption200_Response0" type="schemas:cancel_redemption200_Response0" />
      <xs:element name="get_statement_Request" type="schemas:get_statement_Request" />
      <xs:element name="get_statement200_Response0" type="schemas:get_statement200_Response0" />
      <xs:complexType name="Envelope">
        <xs:sequence>
          <xs:element minOccurs="1" name="status" type="xs:string" />
          <xs:element minOccurs="1" name="summary" type="xs:string" />
          <xs:element minOccurs="1" maxOccurs="unbounded" name="reason_codes" type="xs:string" />
          <xs:element minOccurs="1" name="data">
            <xs:complexType>
              <xs:sequence>
                <xs:any />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="next_actions" type="schemas:NextAction" />
          <xs:element minOccurs="1" name="docs_url" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiV1AcceptOfferRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="offer_id" type="xs:string" />
          <xs:element minOccurs="1" name="disclosure_hash">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:minLength value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiV1AckNoticesRequest">
        <xs:sequence>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="notice_ids" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiV1ApplyForLoanRequest">
        <xs:sequence>
          <xs:element minOccurs="0" name="identity" type="schemas:Identity" />
          <xs:element minOccurs="1" name="amount_cents">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:maxInclusive value="9007199254740991" />
                <xs:minInclusive value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="term_days">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:maxInclusive value="9007199254740991" />
                <xs:minInclusive value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="purpose">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="200" />
                <xs:minLength value="5" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="invoice" type="schemas:Invoice" />
          <xs:element minOccurs="0" name="declarations" type="schemas:Declarations" />
          <xs:element minOccurs="0" name="consent_bank_records" type="xs:boolean" />
          <xs:element minOccurs="0" name="mandate_version">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:maxInclusive value="9007199254740991" />
                <xs:minInclusive value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="attest" type="xs:boolean" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiV1BuyNotesRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="amount_cents">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:maxInclusive value="100000" />
                <xs:minInclusive value="1000" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiV1CancelRedemptionRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="note_tx_id" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiV1CheckEligibilityRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="amount_cents">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:maxInclusive value="9007199254740991" />
                <xs:minInclusive value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="term_days">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:maxInclusive value="9007199254740991" />
                <xs:minInclusive value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="collateral" type="schemas:Collateral" />
          <xs:element minOccurs="0" name="invoice_amount_cents">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:maxInclusive value="9007199254740991" />
                <xs:minInclusive value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiV1ConfirmCheckoutRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="checkout_id">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:minLength value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiV1DeclineOfferRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="offer_id" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiV1GetApplicationRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="application_id" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiV1GetLoanRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="loan_id" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiV1RedeemNotesRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="amount_cents">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:maxInclusive value="9007199254740991" />
                <xs:minInclusive value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiV1RegisterAgentRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="name">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="60" />
                <xs:minLength value="2" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="operator" type="xs:string" />
          <xs:element minOccurs="0" name="model" type="xs:string" />
          <xs:element minOccurs="0" name="payout_email">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>The PayPal account (by email) that receives loans and redemptions. Give this or payout_paypal_id.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:pattern value="^(?:[A-Za-z0-9_'+\-]+\.)*[A-Za-z0-9_'+\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\-]*\.)+[A-Za-z]{2,}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="payout_paypal_id">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>The PayPal account (by payer ID) that receives loans and redemptions, instead of payout_email — use it when that account's email is unconfirmed (payouts to an unconfirmed email go UNCLAIMED).</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:pattern value="^[A-Z0-9]{13}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiV1RegisterPublicKeyRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="public_key">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Your Ed25519 public key, base64: the raw 32 bytes or the SPKI DER encoding.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:maxLength value="512" />
                <xs:minLength value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiV1RepayLoanRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="loan_id" type="xs:string" />
          <xs:element minOccurs="0" name="amount_cents">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:maxInclusive value="9007199254740991" />
                <xs:minInclusive value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:simpleType name="Collateral">
        <xs:restriction base="xs:string">
          <xs:enumeration value="invoice_link" />
          <xs:enumeration value="none" />
        </xs:restriction>
      </xs:simpleType>
      <xs:complexType name="Declarations">
        <xs:sequence>
          <xs:element minOccurs="1" name="no_other_debt" type="xs:boolean" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Identity">
        <xs:sequence>
          <xs:element minOccurs="0" name="operator">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="200" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="model">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="200" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="code_manifest_hash">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="200" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Invoice">
        <xs:sequence>
          <xs:element minOccurs="1" name="client_email">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:pattern value="^(?:[A-Za-z0-9_'+\-]+\.)*[A-Za-z0-9_'+\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\-]*\.)+[A-Za-z]{2,}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="amount_cents">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:maxInclusive value="9007199254740991" />
                <xs:minInclusive value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="due_in_days">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:maxInclusive value="60" />
                <xs:minInclusive value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="description">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="500" />
                <xs:minLength value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="NextAction">
        <xs:sequence>
          <xs:element minOccurs="1" name="tool" type="xs:string" />
          <xs:element minOccurs="1" name="args">
            <xs:complexType>
              <xs:sequence>
                <xs:any />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="bodyObjectType">
        <xs:sequence>
          <xs:any />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="get_bank_guide_Request">
        <xs:sequence>
          <xs:element minOccurs="1" name="body" type="schemas:bodyObjectType" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="get_bank_guide200_Response0">
        <xs:sequence>
          <xs:element minOccurs="1" name="response200" type="schemas:Envelope">
            <xs:annotation>
              <xs:documentation>Envelope response</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="register_agent_Request">
        <xs:sequence>
          <xs:element minOccurs="1" name="body" type="schemas:ApiV1RegisterAgentRequest" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="register_agent200_Response0">
        <xs:sequence>
          <xs:element minOccurs="1" name="response200" type="schemas:Envelope">
            <xs:annotation>
              <xs:documentation>Envelope response</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="get_status_Request">
        <xs:sequence>
          <xs:element minOccurs="1" name="body" type="schemas:bodyObjectType" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="get_status200_Response0">
        <xs:sequence>
          <xs:element minOccurs="1" name="response200" type="schemas:Envelope">
            <xs:annotation>
              <xs:documentation>Envelope response</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="register_public_key_Request">
        <xs:sequence>
          <xs:element minOccurs="1" name="body" type="schemas:ApiV1RegisterPublicKeyRequest" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="register_public_key200_Response0">
        <xs:sequence>
