            <xs:annotation>
              <xs:documentation>Envelope response</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="buy_notes_Request">
        <xs:sequence>
          <xs:element minOccurs="1" name="body" type="schemas:ApiV1BuyNotesRequest" />
        </xs:sequence>
      </xs:complexType>
