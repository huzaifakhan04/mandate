                      "type": "object"
                    },
                    "next_actions": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "NextAction",
                        "title": "NextAction",
                        "type": "object",
                        "properties": {
                          "tool": {
                            "type": "string"
                          },
                          "args": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "tool",
                          "args"
                        ]
                      }
                    },
