  /get_application:
    post:
      securedBy:
      - bearerAuth
      description: "Returns one of the calling agent's loan applications: its status — OFFERED (the bank made an offer; the application stays OFFERED after the offer is accepted, declined or expires, so use get_loan / get_status for what happened next) or DECLINED (see adverse_action) — the decision, the principal reasons [{code, text}], the adverse_action notice of a decline (your statement of specific reasons), the latest explanation (the loan officer's text, or its template when the AI was unavailable), the offer_id of an offered application, and an echo of the application sections A–H (ala) as submitted. Read-only."
      headers:
        Content-Type:
          example: application/json
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiV1GetApplicationRequest",
              "title": "ApiV1GetApplicationRequest",
              "examples": [
                {
                  "Id": "default",
                  "Name": "Re-read a decision, its reasons and adverse action",
                  "Value": "{\"application_id\":\"7d3a9e52-1f6b-4b28-8c0d-5e4f1a2b3c22\"}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {
                "application_id": "7d3a9e52-1f6b-4b28-8c0d-5e4f1a2b3c22"
              },
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "application_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "application_id"
              ]
            }
          example: '{"application_id":"7d3a9e52-1f6b-4b28-8c0d-5e4f1a2b3c22"}'
      responses:
        '200':
          description: Envelope response
          body:
            application/json:
              schema: |
                {
                  "id": "Envelope",
                  "title": "Envelope",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "reason_codes": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "data": {
                      "type": "object"
                    },
                    "next_actions": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "NextAction",
                        "title": "NextAction",
                        "type": "object",
                        "properties": {
                          "tool": {
                            "type": "string"
                          },
                          "args": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "tool",
                          "args"
                        ]
                      }
                    },
                    "docs_url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
