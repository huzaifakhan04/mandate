                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "summary",
                    "reason_codes",
                    "data",
                    "next_actions",
                    "docs_url"
                  ]
                }
  /check_eligibility:
    post:
      securedBy:
      - bearerAuth
      description: "Checks, without committing to anything, whether the calling agent could borrow amount_cents for term_days right now (P1: 1000–50000 cents, 7–30 days, one open loan, enough pool liquidity, and KYA tier ≥ 1: claimed by your human and covered by a signed mandate) and quotes the fee, APR and total repayment. data.mandate shows the limits your human signed (max per loan, max total owed across all their agents, max fee in bps of the principal, max term, eligible collateral) and the headroom left; breaking one gives a mandate_* reason, and a loan above your tier's cap (T1 25000, T2 50000 cents) gives tier_per_loan. Pass collateral to also check the collateral rule. data.credit is your Agent Credit Score (0–100), grade A–E, grade limit and top 3 factors; pass invoice_amount_cents to include invoice collateral (coverage ≥ 1.5× scores 20 points, ≥ 1.1× scores 12; below 1.1× gives insufficient_collateral). The same underwriting rules as apply_for_loan run: grade E declines (insufficient_credit_history / score_too_low), effective_cap_cents = min(grade limit, tier cap, mandate max_per_loan), grade D above 5000 cents gives manual_review_declined. The quote is risk-based (grade, score, rate components, apr_flag) and null for grade E. Call it before apply_for_loan; if eligible, call apply_for_loan with the same amount and term. While unclaimed, reasons include claim_required and data.claim_url is the link to give your human."
      headers:
        Content-Type:
          example: application/json
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiV1CheckEligibilityRequest",
              "title": "ApiV1CheckEligibilityRequest",
              "examples": [
                {
                  "Id": "default",
                  "Name": "Quote $10 for 7 days against a $15 invoice",
                  "Value": "{\"amount_cents\":1000,\"term_days\":7,\"collateral\":\"invoice_link\",\"invoice_amount_cents\":1500}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {
                "amount_cents": 1000,
                "term_days": 7,
                "collateral": "invoice_link",
                "invoice_amount_cents": 1500
              },
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "amount_cents": {
                  "type": "integer",
                  "minimum": 1.0,
                  "maximum": 9007199254740991.0,
                  "format": "int32"
                },
                "term_days": {
                  "type": "integer",
                  "minimum": 1.0,
                  "maximum": 9007199254740991.0,
                  "format": "int32"
                },
                "collateral": {
                  "title": "Collateral",
                  "type": "string",
                  "additionalProperties": false,
                  "enum": [
                    "invoice_link",
                    "none"
                  ]
                },
                "invoice_amount_cents": {
                  "type": "integer",
                  "minimum": 1.0,
                  "maximum": 9007199254740991.0,
                  "format": "int32"
                }
              },
              "required": [
                "amount_cents",
                "term_days"
              ]
            }
          example: '{"amount_cents":1000,"term_days":7,"collateral":"invoice_link","invoice_amount_cents":1500}'
      responses:
        '200':
          description: Envelope response
          body:
            application/json:
              schema: |
                {
                  "id": "Envelope",
                  "title": "Envelope",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "reason_codes": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "data": {
                      "type": "object"
                    },
                    "next_actions": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "NextAction",
                        "title": "NextAction",
                        "type": "object",
                        "properties": {
                          "tool": {
                            "type": "string"
                          },
                          "args": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "tool",
                          "args"
                        ]
                      }
                    },
                    "docs_url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "summary",
                    "reason_codes",
                    "data",
                    "next_actions",
                    "docs_url"
                  ]
                }
  /apply_for_loan:
    post:
      securedBy:
      - bearerAuth
      description: "Applies for a loan of amount_cents over term_days (optionally backed by an invoice the bank will collect via a payment link; invoice.amount_cents must cover the principal plus the fee, i.e. at least amount_cents + the fee check_eligibility quotes). Returns either DECLINED with reason codes, or OFFERED with a disclosure and its disclosure_hash, valid for one simulated day. Review the disclosure, then call accept_offer with offer_id and disclosure_hash, or decline_offer. Needs KYA tier ≥ 1: an unclaimed agent gets 403 CLAIM_REQUIRED (data.claim_url is the link for your human), a claimed agent without a signed mandate gets 403 MANDATE_REQUIRED. An offer that breaks your owner's mandate is DECLINED with mandate_per_loan / mandate_total_owed / mandate_fee / mandate_term / mandate_collateral, or tier_per_loan above your tier's cap. Applications are underwritten by your Agent Credit Score: grade E declines (insufficient_credit_history / score_too_low), above your grade's limit gives amount_exceeds_limit, grade D above 5000 cents gives manual_review_declined, an invoice covering < 1.1× the amount gives insufficient_collateral (new agents: start with a small invoice-backed loan, invoice ≥ 1.5× the amount). The fee is risk-based; the disclosure shows your score, grade and the rate components, and names the mandate_id and mandate_version it was made under. The application has sections A–H: identity {operator, model, code_manifest_hash} (optional), purpose, amount_cents/term_days, invoice (optional), declarations.no_other_debt (REQUIRED true), consent_bank_records (optional), mandate_version (optional: the mandate version you expect — 409 MANDATE_CHANGED if it is no longer current) and attest (REQUIRED true: the application is accurate). Without declarations.no_other_debt and attest it is DECLINED with declaration_missing. A DECLINED response carries adverse_action {reasons [{code, text}], score, grade, score_factors, notice, explanation}; every response carries an explanation. Re-read either later with get_application."
      headers:
        Content-Type:
          example: application/json
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiV1ApplyForLoanRequest",
              "title": "ApiV1ApplyForLoanRequest",
              "examples": [
                {
                  "Id": "default",
                  "Name": "Apply (ALA A–H): $10 for 7 days, invoice-backed, with the required declarations and attestation",
                  "Value": "{\"amount_cents\":1000,\"term_days\":7,\"purpose\":\"Buy materials for invoice INV-1042\",\"identity\":{\"operator\":\"Acme Ops\",\"model\":\"claude-sonnet\"},\"invoice\":{\"client_email\":\"client@example.com\",\"amount_cents\":1500,\"due_in_days\":7,\"description\":\"INV-1042: website build\"},\"declarations\":{\"no_other_debt\":true},\"consent_bank_records\":true,\"attest\":true}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {
                "amount_cents": 1000,
                "term_days": 7,
                "purpose": "Buy materials for invoice INV-1042",
                "identity": {
                  "operator": "Acme Ops",
                  "model": "claude-sonnet"
                },
                "invoice": {
                  "client_email": "client@example.com",
                  "amount_cents": 1500,
                  "due_in_days": 7,
                  "description": "INV-1042: website build"
                },
                "declarations": {
                  "no_other_debt": true
                },
                "consent_bank_records": true,
                "attest": true
              },
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "amount_cents": {
                  "type": "integer",
                  "minimum": 1.0,
                  "maximum": 9007199254740991.0,
                  "format": "int32"
                },
                "term_days": {
                  "type": "integer",
                  "minimum": 1.0,
                  "maximum": 9007199254740991.0,
                  "format": "int32"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 200
                },
                "identity": {
                  "id": "Identity",
                  "title": "Identity",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "operator": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "model": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "code_manifest_hash": {
                      "type": "string",
                      "maxLength": 200
                    }
                  }
                },
                "invoice": {
                  "id": "Invoice",
                  "title": "Invoice",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "client_email": {
                      "type": "string",
                      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                      "format": "email"
                    },
                    "amount_cents": {
                      "type": "integer",
                      "minimum": 1.0,
                      "maximum": 9007199254740991.0,
                      "format": "int32"
                    },
                    "due_in_days": {
                      "type": "integer",
                      "minimum": 1.0,
                      "maximum": 60.0,
                      "format": "int32"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "client_email",
                    "amount_cents",
                    "due_in_days",
                    "description"
                  ]
                },
                "declarations": {
                  "id": "Declarations",
                  "title": "Declarations",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "no_other_debt": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "no_other_debt"
                  ]
                },
                "consent_bank_records": {
                  "type": "boolean"
                },
                "mandate_version": {
                  "type": "integer",
                  "minimum": 1.0,
                  "maximum": 9007199254740991.0,
                  "format": "int32"
                },
                "attest": {
                  "type": "boolean"
                }
              },
              "required": [
                "amount_cents",
                "term_days",
                "purpose"
              ]
            }
          example: '{"amount_cents":1000,"term_days":7,"purpose":"Buy materials for invoice INV-1042","identity":{"operator":"Acme Ops","model":"claude-sonnet"},"invoice":{"client_email":"client@example.com","amount_cents":1500,"due_in_days":7,"description":"INV-1042: website build"},"declarations":{"no_other_debt":true},"consent_bank_records":true,"attest":true}'
      responses:
        '200':
          description: Envelope response
          body:
            application/json:
              schema: |
                {
                  "id": "Envelope",
                  "title": "Envelope",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "reason_codes": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "data": {
                      "type": "object"
                    },
                    "next_actions": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "NextAction",
                        "title": "NextAction",
                        "type": "object",
                        "properties": {
                          "tool": {
                            "type": "string"
                          },
                          "args": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "tool",
                          "args"
                        ]
                      }
                    },
                    "docs_url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "summary",
                    "reason_codes",
                    "data",
                    "next_actions",
                    "docs_url"
                  ]
                }
  /accept_offer:
    post:
      securedBy:
      - bearerAuth
      description: "Accepts a loan offer from apply_for_loan. disclosure_hash must equal the hash returned with the offer (proof the disclosure was read). The bank re-checks your KYA tier (403 CLAIM_REQUIRED / MANDATE_REQUIRED if you may no longer borrow), your owner's mandate (409 MANDATE_REVOKED if the mandate the offer was made under was revoked or replaced — apply again; 400 MANDATE_LIMIT with mandate_* reasons if the offer no longer fits, e.g. your owner's other agents borrowed meanwhile) liquidity and the bank's treasury policy (409 TREASURY_LIMIT with reserve_floor, concentration_limit or daily_budget_exhausted — apply again later or for less), creates the loan and pays the principal to the agent's PayPal payout receiver: the result is ACTIVE, DISBURSING (poll get_loan) or DISBURSEMENT_FAILED (with the reason)."
      headers:
        Content-Type:
          example: application/json
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiV1AcceptOfferRequest",
              "title": "ApiV1AcceptOfferRequest",
              "examples": [
                {
                  "Id": "default",
                  "Name": "Accept an offer with the disclosure hash it returned (disburses the loan)",
                  "Value": "{\"offer_id\":\"2b0f6c1e-8a43-4c7e-9a51-3f7d2e9b0c11\",\"disclosure_hash\":\"sha256:<disclosure_hash from apply_for_loan>\"}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {
                "offer_id": "2b0f6c1e-8a43-4c7e-9a51-3f7d2e9b0c11",
                "disclosure_hash": "sha256:<disclosure_hash from apply_for_loan>"
              },
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "offer_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "disclosure_hash": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "offer_id",
                "disclosure_hash"
              ]
            }
          example: '{"offer_id":"2b0f6c1e-8a43-4c7e-9a51-3f7d2e9b0c11","disclosure_hash":"sha256:<disclosure_hash from apply_for_loan>"}'
      responses:
        '200':
          description: Envelope response
          body:
            application/json:
              schema: |
                {
                  "id": "Envelope",
                  "title": "Envelope",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "reason_codes": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "data": {
                      "type": "object"
                    },
                    "next_actions": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "NextAction",
                        "title": "NextAction",
                        "type": "object",
                        "properties": {
                          "tool": {
                            "type": "string"
                          },
                          "args": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "tool",
                          "args"
                        ]
                      }
                    },
                    "docs_url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "summary",
                    "reason_codes",
                    "data",
                    "next_actions",
                    "docs_url"
                  ]
                }
  /decline_offer:
    post:
      securedBy:
      - bearerAuth
      description: Declines one of the calling agent's open loan offers (from apply_for_loan), so it can no longer be accepted. Nothing is charged. Call apply_for_loan again later for a new offer, or get_status to see the agent's current position.
      headers:
        Content-Type:
          example: application/json
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiV1DeclineOfferRequest",
              "title": "ApiV1DeclineOfferRequest",
              "examples": [
                {
                  "Id": "default",
                  "Name": "Decline an offer you don't want",
                  "Value": "{\"offer_id\":\"2b0f6c1e-8a43-4c7e-9a51-3f7d2e9b0c11\"}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {
                "offer_id": "2b0f6c1e-8a43-4c7e-9a51-3f7d2e9b0c11"
              },
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "offer_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "offer_id"
              ]
            }
          example: '{"offer_id":"2b0f6c1e-8a43-4c7e-9a51-3f7d2e9b0c11"}'
      responses:
        '200':
          description: Envelope response
          body:
            application/json:
              schema: |
                {
                  "id": "Envelope",
