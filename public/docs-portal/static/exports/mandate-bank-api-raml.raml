              "id": "ApiV1ConfirmCheckoutRequest",
              "title": "ApiV1ConfirmCheckoutRequest",
              "examples": [
                {
                  "Id": "default",
                  "Name": "Capture a checkout after your human approved it",
                  "Value": "{\"checkout_id\":\"<checkout_id from buy_notes or repay_loan>\"}",
