  /redeem_notes:
    post:
      securedBy:
      - bearerAuth
      description: "Redeems lender notes for cash, paid out to the agent's PayPal payout receiver. Fails with INSUFFICIENT_NOTE_BALANCE if the amount exceeds the agent's redeemable balance (position minus any other redemption still settling or queued), or PAYOUT_RECEIVER_MISSING if the agent has no payout receiver on file. If paying now would take the bank's cash below its reserve floor (or others are already queued), the redemption is QUEUED instead: data.queue says its position, why, and how much more cash is needed; the bank pays the queue in order automatically, and cancel_redemption withdraws it."
      headers:
        Content-Type:
          example: application/json
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiV1RedeemNotesRequest",
              "title": "ApiV1RedeemNotesRequest",
              "examples": [
                {
                  "Id": "default",
                  "Name": "Redeem $10 of notes to your PayPal payout receiver",
                  "Value": "{\"amount_cents\":1000}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {
                "amount_cents": 1000
              },
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "amount_cents": {
                  "type": "integer",
                  "minimum": 1.0,
                  "maximum": 9007199254740991.0,
                  "format": "int32"
                }
              },
              "required": [
                "amount_cents"
              ]
            }
          example: '{"amount_cents":1000}'
      responses:
        '200':
          description: Envelope response
          body:
            application/json:
              schema: |
                {
                  "id": "Envelope",
                  "title": "Envelope",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "reason_codes": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "data": {
                      "type": "object"
                    },
                    "next_actions": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "NextAction",
                        "title": "NextAction",
                        "type": "object",
                        "properties": {
                          "tool": {
                            "type": "string"
                          },
                          "args": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "tool",
                          "args"
                        ]
                      }
                    },
                    "docs_url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "summary",
                    "reason_codes",
                    "data",
                    "next_actions",
                    "docs_url"
                  ]
                }
  /cancel_redemption:
    post:
      securedBy:
      - bearerAuth
      description: Cancels one of the calling agent's QUEUED note redemptions (redeem_notes returns QUEUED with note_tx_id when the bank's reserve floor gates a payout). The units are yours again at once; nothing was paid. A redemption already being paid out (PENDING) can't be cancelled (409 INVALID_TRANSITION).
      headers:
        Content-Type:
          example: application/json
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiV1CancelRedemptionRequest",
              "title": "ApiV1CancelRedemptionRequest",
              "examples": [
                {
                  "Id": "default",
                  "Name": "Withdraw a queued redemption",
                  "Value": "{\"note_tx_id\":\"4e8b2c6d-5a1f-4d3e-9b7c-1a2b3c4d5e44\"}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {
                "note_tx_id": "4e8b2c6d-5a1f-4d3e-9b7c-1a2b3c4d5e44"
              },
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "note_tx_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "note_tx_id"
              ]
            }
          example: '{"note_tx_id":"4e8b2c6d-5a1f-4d3e-9b7c-1a2b3c4d5e44"}'
      responses:
        '200':
          description: Envelope response
          body:
            application/json:
              schema: |
                {
                  "id": "Envelope",
                  "title": "Envelope",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "reason_codes": {
