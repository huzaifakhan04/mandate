#%RAML 0.8
title: Mandate Bank API
version: 1.0.0
documentation:
- title: Mandate Bank API
  content: 'Mandate is a sandbox bank for AI agents on PayPal sandbox: buy lender notes, borrow short-term loans, repay. Every tool is also an MCP tool at /api/mcp/mcp; full agent guide at /agents.md. Sandbox only — no real money.'
baseUri: https://agentic-bank-mu.vercel.app
securedBy: []
protocols:
- HTTPS
baseUriParameters: {}
schemas:
- Envelope: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Envelope",
      "title": "Envelope",
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "reason_codes": {
          "description": "",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data": {
          "type": "object"
        },
        "next_actions": {
          "description": "",
          "type": "array",
          "items": {
            "id": "NextAction",
            "title": "NextAction",
            "type": "object",
            "properties": {
              "tool": {
                "type": "string"
              },
              "args": {
                "type": "object"
              }
            },
            "required": [
              "tool",
              "args"
            ]
          }
        },
        "docs_url": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "summary",
        "reason_codes",
        "data",
        "next_actions",
        "docs_url"
      ]
    }
- ApiV1AcceptOfferRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiV1AcceptOfferRequest",
      "title": "ApiV1AcceptOfferRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offer_id": {
          "type": "string",
          "format": "uuid"
        },
        "disclosure_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "offer_id",
        "disclosure_hash"
      ]
    }
- ApiV1AckNoticesRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiV1AckNoticesRequest",
      "title": "ApiV1AckNoticesRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notice_ids": {
          "description": "",
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1,
          "maxItems": 100
        }
      }
    }
- ApiV1ApplyForLoanRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiV1ApplyForLoanRequest",
      "title": "ApiV1ApplyForLoanRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount_cents": {
          "type": "integer",
          "minimum": 1.0,
          "maximum": 9007199254740991.0,
          "format": "int32"
        },
        "term_days": {
          "type": "integer",
          "minimum": 1.0,
          "maximum": 9007199254740991.0,
          "format": "int32"
        },
        "purpose": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "identity": {
          "id": "Identity",
          "title": "Identity",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operator": {
              "type": "string",
              "maxLength": 200
            },
            "model": {
              "type": "string",
              "maxLength": 200
            },
            "code_manifest_hash": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "invoice": {
          "id": "Invoice",
          "title": "Invoice",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "client_email": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
              "format": "email"
            },
            "amount_cents": {
              "type": "integer",
              "minimum": 1.0,
              "maximum": 9007199254740991.0,
              "format": "int32"
            },
            "due_in_days": {
              "type": "integer",
              "minimum": 1.0,
              "maximum": 60.0,
              "format": "int32"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "client_email",
            "amount_cents",
            "due_in_days",
            "description"
          ]
        },
        "declarations": {
          "id": "Declarations",
          "title": "Declarations",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "no_other_debt": {
              "type": "boolean"
            }
          },
          "required": [
            "no_other_debt"
          ]
        },
        "consent_bank_records": {
          "type": "boolean"
        },
        "mandate_version": {
          "type": "integer",
          "minimum": 1.0,
          "maximum": 9007199254740991.0,
          "format": "int32"
        },
        "attest": {
          "type": "boolean"
        }
      },
      "required": [
        "amount_cents",
        "term_days",
        "purpose"
      ]
    }
- ApiV1BuyNotesRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiV1BuyNotesRequest",
      "title": "ApiV1BuyNotesRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount_cents": {
          "type": "integer",
          "minimum": 1000.0,
          "maximum": 100000.0,
          "format": "int32"
        }
      },
      "required": [
        "amount_cents"
      ]
    }
- ApiV1CancelRedemptionRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiV1CancelRedemptionRequest",
      "title": "ApiV1CancelRedemptionRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note_tx_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "note_tx_id"
      ]
    }
- ApiV1CheckEligibilityRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiV1CheckEligibilityRequest",
      "title": "ApiV1CheckEligibilityRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount_cents": {
          "type": "integer",
          "minimum": 1.0,
          "maximum": 9007199254740991.0,
          "format": "int32"
        },
        "term_days": {
          "type": "integer",
          "minimum": 1.0,
          "maximum": 9007199254740991.0,
          "format": "int32"
        },
        "collateral": {
          "title": "Collateral",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "invoice_link",
            "none"
          ]
        },
        "invoice_amount_cents": {
          "type": "integer",
          "minimum": 1.0,
          "maximum": 9007199254740991.0,
          "format": "int32"
        }
      },
      "required": [
        "amount_cents",
        "term_days"
      ]
    }
- ApiV1ConfirmCheckoutRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiV1ConfirmCheckoutRequest",
      "title": "ApiV1ConfirmCheckoutRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkout_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "checkout_id"
      ]
    }
- ApiV1DeclineOfferRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiV1DeclineOfferRequest",
      "title": "ApiV1DeclineOfferRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offer_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "offer_id"
      ]
    }
- ApiV1GetApplicationRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiV1GetApplicationRequest",
      "title": "ApiV1GetApplicationRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "application_id"
      ]
    }
- ApiV1GetLoanRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiV1GetLoanRequest",
      "title": "ApiV1GetLoanRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loan_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "loan_id"
      ]
    }
- ApiV1RedeemNotesRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiV1RedeemNotesRequest",
      "title": "ApiV1RedeemNotesRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount_cents": {
          "type": "integer",
          "minimum": 1.0,
          "maximum": 9007199254740991.0,
          "format": "int32"
        }
      },
      "required": [
        "amount_cents"
      ]
    }
- ApiV1RegisterAgentRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiV1RegisterAgentRequest",
      "title": "ApiV1RegisterAgentRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "operator": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "payout_email": {
          "description": "The PayPal account (by email) that receives loans and redemptions. Give this or payout_paypal_id.",
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "format": "email"
        },
        "payout_paypal_id": {
          "description": "The PayPal account (by payer ID) that receives loans and redemptions, instead of payout_email — use it when that account's email is unconfirmed (payouts to an unconfirmed email go UNCLAIMED).",
          "type": "string",
          "pattern": "^[A-Z0-9]{13}$"
        }
      },
      "required": [
        "name"
      ]
    }
- ApiV1RegisterPublicKeyRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiV1RegisterPublicKeyRequest",
      "title": "ApiV1RegisterPublicKeyRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_key": {
          "description": "Your Ed25519 public key, base64: the raw 32 bytes or the SPKI DER encoding.",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "public_key"
      ]
    }
- ApiV1RepayLoanRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiV1RepayLoanRequest",
      "title": "ApiV1RepayLoanRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loan_id": {
          "type": "string",
          "format": "uuid"
        },
        "amount_cents": {
          "type": "integer",
          "minimum": 1.0,
          "maximum": 9007199254740991.0,
          "format": "int32"
        }
      },
      "required": [
        "loan_id"
      ]
    }
- Collateral: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "Collateral",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "invoice_link",
        "none"
      ]
    }
- Declarations: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Declarations",
      "title": "Declarations",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "no_other_debt": {
          "type": "boolean"
        }
      },
      "required": [
        "no_other_debt"
      ]
    }
- Identity: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Identity",
      "title": "Identity",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operator": {
          "type": "string",
          "maxLength": 200
        },
        "model": {
          "type": "string",
          "maxLength": 200
        },
        "code_manifest_hash": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
- Invoice: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Invoice",
      "title": "Invoice",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_email": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "format": "email"
        },
        "amount_cents": {
          "type": "integer",
          "minimum": 1.0,
          "maximum": 9007199254740991.0,
          "format": "int32"
        },
        "due_in_days": {
          "type": "integer",
          "minimum": 1.0,
          "maximum": 60.0,
          "format": "int32"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "client_email",
        "amount_cents",
        "due_in_days",
        "description"
      ]
    }
- NextAction: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "NextAction",
      "title": "NextAction",
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "args": {
          "type": "object"
        }
      },
      "required": [
        "tool",
        "args"
      ]
    }
/api/v1:
  /get_bank_guide:
    post:
      securedBy: []
      description: "Returns an orientation guide to Mandate for agents: what the bank is, how to start, which tools exist, the money rules in force, and links to the full /agents.md and /llms.txt docs. Call this first, before register_agent, to confirm you're pointed at the right bank and see every available tool."
      headers:
        Content-Type:
          example: application/json
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "examples": [
                {
                  "Id": "default",
                  "Name": "Orientation: what the bank is, every tool, the money rules",
                  "Value": "{}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {},
              "type": "object"
            }
          example: '{}'
      responses:
        '200':
          description: Envelope response
          body:
            application/json:
              schema: |
                {
                  "id": "Envelope",
                  "title": "Envelope",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "reason_codes": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "data": {
                      "type": "object"
                    },
                    "next_actions": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "NextAction",
                        "title": "NextAction",
                        "type": "object",
                        "properties": {
                          "tool": {
                            "type": "string"
                          },
                          "args": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "tool",
                          "args"
                        ]
                      }
                    },
                    "docs_url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "summary",
                    "reason_codes",
                    "data",
                    "next_actions",
                    "docs_url"
                  ]
                }
  /register_agent:
    post:
      securedBy: []
      description: "Creates a new agent and an API key for it. Call this first, before any other tool — every other call authenticates with the returned api_key. Creates a fresh agent every time it's called (no dedupe), so call it once per agent and store the key immediately: it is never shown again. The agent starts ACTIVE at KYA tier 0: it can lend (buy/redeem notes) but not borrow. Give your human the returned claim_url (valid 7 days; get_status shows it again) — once they claim you and sign a mandate, you can borrow."
      headers:
        Content-Type:
          example: application/json
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiV1RegisterAgentRequest",
              "title": "ApiV1RegisterAgentRequest",
              "examples": [
                {
                  "Id": "default",
                  "Name": "Register with a PayPal payout account (no API key needed)",
                  "Value": "{\"name\":\"Acme Ops Agent\",\"operator\":\"Acme Ops\",\"model\":\"claude-sonnet\",\"payout_email\":\"agent@example.com\"}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {
                "name": "Acme Ops Agent",
                "operator": "Acme Ops",
                "model": "claude-sonnet",
                "payout_email": "agent@example.com"
              },
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 60
                },
                "operator": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "payout_email": {
                  "description": "The PayPal account (by email) that receives loans and redemptions. Give this or payout_paypal_id.",
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                  "format": "email"
                },
                "payout_paypal_id": {
                  "description": "The PayPal account (by payer ID) that receives loans and redemptions, instead of payout_email — use it when that account's email is unconfirmed (payouts to an unconfirmed email go UNCLAIMED).",
                  "type": "string",
                  "pattern": "^[A-Z0-9]{13}$"
                }
              },
              "required": [
                "name"
              ]
            }
          example: '{"name":"Acme Ops Agent","operator":"Acme Ops","model":"claude-sonnet","payout_email":"agent@example.com"}'
      responses:
        '200':
          description: Envelope response
          body:
            application/json:
              schema: |
                {
                  "id": "Envelope",
                  "title": "Envelope",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "reason_codes": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "data": {
                      "type": "object"
                    },
                    "next_actions": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "NextAction",
                        "title": "NextAction",
                        "type": "object",
                        "properties": {
                          "tool": {
                            "type": "string"
                          },
                          "args": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "tool",
                          "args"
                        ]
                      }
                    },
                    "docs_url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "summary",
                    "reason_codes",
                    "data",
                    "next_actions",
                    "docs_url"
                  ]
                }
  /get_status:
    post:
      securedBy:
      - bearerAuth
      description: "Returns the calling agent's own account snapshot: status, KYA tier (and the claim_url to give your human while you are unclaimed), note and payable balances, any open loan, lending limits, your Agent Credit Score (0–100, grade A–E, grade limit, top 3 factors), unread notices (late fees, penalty, substandard — acknowledge with ack_notices), and the current simulated time. Call it any time to decide what to do next — after registering, after buying notes, or while waiting on a loan."
      headers:
        Content-Type:
          example: application/json
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "examples": [
                {
                  "Id": "default",
                  "Name": "Your agent, KYA tier, mandate, positions and open items",
                  "Value": "{}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {},
              "type": "object"
            }
          example: '{}'
      responses:
        '200':
          description: Envelope response
          body:
            application/json:
              schema: |
                {
                  "id": "Envelope",
                  "title": "Envelope",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "reason_codes": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "data": {
                      "type": "object"
                    },
                    "next_actions": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "NextAction",
                        "title": "NextAction",
                        "type": "object",
                        "properties": {
                          "tool": {
                            "type": "string"
                          },
                          "args": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "tool",
                          "args"
                        ]
                      }
                    },
                    "docs_url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "summary",
                    "reason_codes",
                    "data",
                    "next_actions",
                    "docs_url"
                  ]
                }
  /register_public_key:
    post:
      securedBy:
      - bearerAuth
      description: "Registers the calling agent's Ed25519 request-signing key (optional; together with an approved KYA document it unlocks KYA tier T2). The request itself must be signed by the key being registered (X-Mandate-Timestamp + X-Mandate-Signature, see 'Signing requests' in agents.md). Once a key is registered, every mutating call from this agent must be signed by it (unsigned → SIGNATURE_REQUIRED). Registering a different key rotates: also send X-Mandate-Previous-Signature from the current key; the old key is revoked."
      headers:
        Content-Type:
          example: application/json
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
