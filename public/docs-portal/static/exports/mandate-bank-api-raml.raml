                    "reason_codes",
                    "data",
                    "next_actions",
                    "docs_url"
                  ]
                }
  /get_loan:
    post:
      securedBy:
      - bearerAuth
      description: "Returns one of the calling agent's loans: its status (DISBURSING, ACTIVE, LATE, SUBSTANDARD, CHARGED_OFF, RECOVERED, DISBURSEMENT_FAILED, REPAID), principal, fee, outstanding balance, due date, delinquency (days late, late fees, rate penalty, total due) and unread notices about it, the invoice repayment link to forward to the client (if the loan has an invoice) and full event history. Call it after accept_offer to follow the disbursement, and while the loan is open to see what is still owed. It may finish creating the payment link on first call (an idempotent PayPal step); it never changes the loan."
      headers:
        Content-Type:
          example: application/json
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiV1GetLoanRequest",
              "title": "ApiV1GetLoanRequest",
              "examples": [
                {
                  "Id": "default",
                  "Name": "Loan status, balance, repayment link and history",
                  "Value": "{\"loan_id\":\"9c1e4b7a-3d2f-4a6e-b8c9-0f1e2d3c4b33\"}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {
                "loan_id": "9c1e4b7a-3d2f-4a6e-b8c9-0f1e2d3c4b33"
              },
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "loan_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "loan_id"
              ]
            }
          example: '{"loan_id":"9c1e4b7a-3d2f-4a6e-b8c9-0f1e2d3c4b33"}'
      responses:
        '200':
          description: Envelope response
          body:
            application/json:
              schema: |
                {
                  "id": "Envelope",
                  "title": "Envelope",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "reason_codes": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "data": {
                      "type": "object"
                    },
                    "next_actions": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "NextAction",
                        "title": "NextAction",
                        "type": "object",
                        "properties": {
                          "tool": {
                            "type": "string"
                          },
                          "args": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "tool",
                          "args"
                        ]
                      }
                    },
                    "docs_url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "summary",
                    "reason_codes",
                    "data",
                    "next_actions",
                    "docs_url"
                  ]
                }
  /repay_loan:
    post:
      securedBy:
      - bearerAuth
      description: "Repays the calling agent's ACTIVE, LATE or SUBSTANDARD loan directly through a PayPal checkout the agent's human approves (a restricted agent may still repay). amount_cents defaults to everything owed (total_due_cents) and may not exceed it; late fees are paid first, then the rate penalty, the fee, then principal. A CHARGED_OFF loan can still be repaid: the payment is a recovery of what was written off (total_due_cents). Present the approve_url to the payer, then call confirm_checkout."
      headers:
        Content-Type:
          example: application/json
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiV1RepayLoanRequest",
              "title": "ApiV1RepayLoanRequest",
              "examples": [
                {
                  "Id": "default",
                  "Name": "Repay the full outstanding balance (PayPal checkout)",
                  "Value": "{\"loan_id\":\"9c1e4b7a-3d2f-4a6e-b8c9-0f1e2d3c4b33\"}",
                  "ExternalValue": null,
                  "Description": null
                },
                {
                  "Id": "example_2",
                  "Name": "Repay part of it",
                  "Value": "{\"loan_id\":\"9c1e4b7a-3d2f-4a6e-b8c9-0f1e2d3c4b33\",\"amount_cents\":500}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {
                "loan_id": "9c1e4b7a-3d2f-4a6e-b8c9-0f1e2d3c4b33"
              },
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "loan_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "amount_cents": {
                  "type": "integer",
                  "minimum": 1.0,
                  "maximum": 9007199254740991.0,
                  "format": "int32"
                }
              },
              "required": [
                "loan_id"
              ]
            }
          example: '{"loan_id":"9c1e4b7a-3d2f-4a6e-b8c9-0f1e2d3c4b33"}'
      responses:
        '200':
          description: Envelope response
          body:
            application/json:
              schema: |
                {
                  "id": "Envelope",
                  "title": "Envelope",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "reason_codes": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "data": {
                      "type": "object"
                    },
                    "next_actions": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "NextAction",
                        "title": "NextAction",
                        "type": "object",
                        "properties": {
                          "tool": {
                            "type": "string"
                          },
                          "args": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "tool",
                          "args"
                        ]
                      }
                    },
                    "docs_url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "summary",
                    "reason_codes",
                    "data",
                    "next_actions",
                    "docs_url"
                  ]
                }
  /ack_notices:
    post:
      securedBy:
      - bearerAuth
      description: Marks the calling agent's notices (late fee, rate penalty, substandard, cured — listed by get_status and get_loan) as read. Pass notice_ids to acknowledge specific ones, or nothing to acknowledge all unread notices. It changes nothing about the loan or what is owed.
      headers:
        Content-Type:
          example: application/json
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiV1AckNoticesRequest",
              "title": "ApiV1AckNoticesRequest",
              "examples": [
                {
                  "Id": "default",
                  "Name": "Acknowledge every open notice (late, dunning, rate change)",
                  "Value": "{}",
                  "ExternalValue": null,
